{
  "env_name": "word64_only",
  "plugin": {
    "configuration": "Release",
    "prog_id": "WordTools.ThisAddIn",
    "word_architecture": "x64"
  },
  "hosts": {
    "word": { "enabled": true, "expected_bitness": "64" },
    "wps": { "enabled": false, "expected_bitness": "32" }
  },
  "phases": {
    "probe": true,
    "register": true,
    "verify_registration": false,
    "smoke": true,
    "unregister": true,
    "verify_cleanup": true
  },
  "registration_cases": [
    {
      "case_id": "REG-001",
      "case_name": "识别并预览注册 Word64",
      "requested_host": "Word",
      "execution_intent": "PreviewOnly"
    },
    {
      "case_id": "REG-020",
      "case_name": "只注册 Word64",
      "requested_host": "Word",
      "execution_intent": "PreviewOnly"
    }
  ],
  "smoke": {
    "mode": "com_load",
    "host_target": "Word"
  },
  "unregister": { "execution_intent": "PreviewOnly" },
  "test_assets": {
    "docx": "assets/blank.docx",
    "image": "assets/test-small.jpg"
  },
  "output": {
    "report_dir": "reports/word64_only",
    "screenshot_dir": "screenshots/word64_only"
  }
}
