{
  "env_name": "word64_wps32_live_register",
  "plugin": {
    "configuration": "Release",
    "prog_id": "WordTools.ThisAddIn"
  },
  "hosts": {
    "word": { "enabled": true, "expected_bitness": "64" },
    "wps": { "enabled": true, "expected_bitness": "32" }
  },
  "phases": {
    "probe": true,
    "register": true,
    "verify_registration": true,
    "smoke": true,
    "unregister": true,
    "verify_cleanup": true
  },
  "registration_cases": [
    {
      "case_id": "REG-020",
      "case_name": "Live 注册 Word64",
      "requested_host": "Word",
      "execution_intent": "Live"
    }
  ],
  "unregister": {
    "execution_intent": "Live",
    "requested_host": "Word"
  },
  "smoke": {
    "mode": "com_load",
    "host_target": "Word"
  },
  "output": {
    "report_dir": "reports/word64_wps32_live_register",
    "screenshot_dir": "screenshots/word64_wps32_live_register"
  }
}
